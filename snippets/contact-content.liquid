<div class="flex flex-col w-full">
<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden bg-surface">
<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[340px] bg-gradient-to-b from-surface-variant/40 via-surface-container/20 to-transparent blur-3xl pointer-events-none -z-10"></div>
<div class="max-w-7xl mx-auto px-spacing-xl py-spacing-3xl">
<!-- Breadcrumb & Tag -->
<div class="flex items-center gap-spacing-xs mb-spacing-md">
<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">Home</a>
<span class="text-on-surface-variant font-label-md text-label-md">/</span>
<span class="font-label-md text-label-md text-on-surface font-semibold">Contact Concierge</span>
</div>
<!-- Page Editorial Headline -->
<div class="max-w-3xl mb-spacing-3xl space-y-spacing-xs">
<div class="inline-flex items-center gap-spacing-xs px-spacing-sm py-spacing-2xs rounded-full bg-secondary-container text-on-surface mb-spacing-xs">
<span class="material-symbols-outlined text-[16px] text-primary">clinical_notes</span>
<span class="font-caption-caps text-caption-caps uppercase tracking-wider">Clinical Care Concierge</span>
</div>
<h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">
          We’re Here For Your Hair Journey. <span class="italic font-normal">Get in Touch.</span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          Whether you require bespoke routine formulation, order tracking guidance, or clinical insights into our Australian active botanicals, our team is ready to support you.
        </p>
</div>
<!-- Main Two-Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-spacing-3xl items-start">
<!-- Left Column: Contact Cards & Diagnostic Booking -->
<div class="lg:col-span-5 space-y-spacing-lg">
{% assign has_custom_channels = false %}
{% if section.blocks.size > 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'contact_channel' %}
      {% assign has_custom_channels = true %}
      <div class="bg-surface-container-lowest rounded-xl p-spacing-xl shadow-sm hover:shadow-md transition-shadow" {{ block.shopify_attributes }}>
        <div class="flex items-start gap-spacing-md">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface">
            <span class="material-symbols-outlined text-[24px]">support_agent</span>
          </div>
          <div class="space-y-spacing-2xs flex-1">
            <h2 class="font-headline-sm text-headline-sm text-on-surface">{{ block.settings.title }}</h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{{ block.settings.info }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endif %}
{% unless has_custom_channels %}
<!-- Support Email Card -->
<div class="bg-surface-container-lowest rounded-xl p-spacing-xl shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface">
<span class="material-symbols-outlined text-[24px]">mail</span>
</div>
<div class="space-y-spacing-2xs flex-1">
<div class="flex items-center justify-between">
<h2 class="font-headline-sm text-headline-sm text-on-surface">Email Assistance</h2>
<span class="font-caption-caps text-caption-caps uppercase px-spacing-xs py-spacing-2xs rounded-full bg-surface-container text-on-surface-variant">24-48h reply</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">Direct clinical inquiries, ingredient analysis & batch requests.</p>
<a class="inline-flex items-center gap-spacing-xs font-label-lg text-label-lg text-primary font-semibold hover:underline pt-spacing-xs" href="mailto:support@kusculture.com">
<span>support@kusculture.com</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</div>
</div>
<!-- Live Chat Card -->
<div class="bg-surface-container-lowest rounded-xl p-spacing-xl shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center flex-shrink-0 text-on-surface">
<span class="material-symbols-outlined text-[24px]">forum</span>
</div>
<div class="space-y-spacing-2xs flex-1">
<div class="flex items-center justify-between">
<h2 class="font-headline-sm text-headline-sm text-on-surface">Live Chat Concierge</h2>
<div class="flex items-center gap-spacing-2xs">
<span class="w-2 h-2 rounded-full bg-tertiary-container animate-pulse"></span>
<span class="font-label-sm text-label-sm text-tertiary font-bold uppercase">Active</span>
</div>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">Instant real-time scalp support & consultation.</p>
<p class="font-label-md text-label-md text-on-surface font-semibold pt-spacing-xs">Monday – Friday • 9:00 AM – 6:00 PM AEST</p>
</div>
</div>
</div>
<!-- Australian HQ & Warehouse -->
<div class="bg-surface-container-lowest rounded-xl p-spacing-xl shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface">
<span class="material-symbols-outlined text-[24px]">location_on</span>
</div>
<div class="space-y-spacing-2xs flex-1">
<h2 class="font-headline-sm text-headline-sm text-on-surface">Melbourne Laboratories & HQ</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant">Formulated, clinically batch-tested and dispatched directly from Victoria.</p>
<p class="font-body-md text-body-md text-on-surface pt-spacing-xs">Melbourne, VIC 3000, Australia</p>
</div>
</div>
</div>
{% endunless %}
<!-- Hair Routine Advisory Booking Box -->
<div class="bg-gradient-to-br from-surface-container to-secondary-container rounded-xl p-spacing-xl shadow-sm relative overflow-hidden">
<div class="flex items-start gap-spacing-md relative z-10">
<div class="w-12 h-12 rounded-full bg-primary-container text-surface flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-[24px]">calendar_month</span>
</div>
<div class="space-y-spacing-xs flex-1">
<div class="inline-flex items-center gap-1 bg-surface-container-lowest px-spacing-xs py-spacing-2xs rounded-full">
<span class="material-symbols-outlined text-[14px] text-tertiary">star</span>
<span class="font-caption-caps text-caption-caps uppercase text-on-surface">Free 1-on-1 Session</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Virtual Hair Routine Advisory</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                  Book a 15-minute video diagnostic with our trichologist team to analyze porosity, scalp microbiome health, and breakage patterns.
                </p>
<button class="mt-spacing-xs bg-primary text-on-primary font-label-md text-label-md px-spacing-lg py-spacing-sm rounded-full hover:bg-primary-container transition-colors inline-flex items-center gap-spacing-xs" type="button">
<span>Reserve Advisory Slot</span>
<span class="material-symbols-outlined text-[18px]">event_available</span>
</button>
</div>
</div>
</div>
</div>
<!-- Right Column: Sleek Form Stage -->
<div class="lg:col-span-7">
<div class="bg-surface-container-lowest rounded-xl p-spacing-2xl shadow-md relative">
<div class="mb-spacing-xl space-y-spacing-2xs">
<span class="font-caption-caps text-caption-caps uppercase tracking-wider text-secondary">Direct Inquiry Desk</span>
<h2 class="font-display-sm text-display-sm text-on-surface">Send Our Chemists a Note</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Fill in your details below and an Australian hair care specialist will review your inquiry.</p>
</div>
<form class="space-y-spacing-lg" id="concierge-form" onsubmit="event.preventDefault(); document.getElementById('form-feedback').classList.remove('hidden');">
<div class="grid grid-cols-1 md:grid-cols-2 gap-spacing-lg">
<!-- Full Name -->
<div class="space-y-spacing-xs">
<label class="font-label-md text-label-md text-on-surface block" for="full-name">Your Full Name <span class="text-error">*</span></label>
<input class="w-full bg-surface rounded-xl px-spacing-md py-spacing-sm font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low transition-colors" id="full-name" placeholder="e.g. Eleanor Vance" required="" type="text"/>
</div>
<!-- Email Address -->
<div class="space-y-spacing-xs">
<label class="font-label-md text-label-md text-on-surface block" for="email-address">Email Address <span class="text-error">*</span></label>
<input class="w-full bg-surface rounded-xl px-spacing-md py-spacing-sm font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low transition-colors" id="email-address" placeholder="name@domain.com" required="" type="email"/>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-spacing-lg">
<!-- Order Number -->
<div class="space-y-spacing-xs">
<div class="flex items-center justify-between">
<label class="font-label-md text-label-md text-on-surface block" for="order-id">Order Number</label>
<span class="font-caption-caps text-caption-caps text-on-surface-variant uppercase">Optional</span>
</div>
<input class="w-full bg-surface rounded-xl px-spacing-md py-spacing-sm font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low transition-colors" id="order-id" placeholder="e.g. #KC-89421" type="text"/>
</div>
<!-- Subject Dropdown -->
<div class="space-y-spacing-xs">
<label class="font-label-md text-label-md text-on-surface block" for="subject-category">Nature of Inquiry <span class="text-error">*</span></label>
<div class="relative">
<select class="w-full bg-surface appearance-none rounded-xl px-spacing-md py-spacing-sm font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-low transition-colors pr-10 cursor-pointer" id="subject-category" required="">
<option value="routine">Routine Advice & Diagnostic Help</option>
<option value="order">Order Tracking & Delivery</option>
<option value="returns">Returns & 30-Day Guarantee</option>
<option value="wholesale">Salon Partnership & Wholesale</option>
<option value="other">General Formula Query</option>
</select>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                      expand_more
                    </span>
</div>
</div>
</div>
<!-- Message Textarea -->
<div class="space-y-spacing-xs">
<label class="font-label-md text-label-md text-on-surface block" for="inquiry-message">Your Message <span class="text-error">*</span></label>
<textarea class="w-full bg-surface rounded-xl p-spacing-md font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low transition-colors resize-none" id="inquiry-message" placeholder="Tell us about your hair type, scalp concerns, or order status..." required="" rows="5"></textarea>
</div>
<!-- Submit Button & Assurances -->
<div class="pt-spacing-xs flex flex-col sm:flex-row items-center justify-between gap-spacing-md">
<button class="w-full sm:w-auto bg-primary text-on-primary font-label-lg text-label-lg uppercase tracking-wider px-spacing-3xl py-spacing-md rounded-full hover:bg-primary-container transition-all flex items-center justify-center gap-spacing-sm shadow-md active:scale-95" type="submit">
<span>Send Message</span>
<span class="material-symbols-outlined text-[18px]">send</span>
</button>
<span class="font-body-sm text-body-sm text-on-surface-variant text-center sm:text-right">
                  Encrypted • Strictly confidential
                </span>
</div>
<!-- Success Alert Banner (Hidden initially) -->
<div class="hidden rounded-xl bg-surface-container-low p-spacing-md flex items-center gap-spacing-sm" id="form-feedback">
<span class="material-symbols-outlined text-tertiary text-[24px]">check_circle</span>
<p class="font-body-sm text-body-sm text-on-surface">Thank you! Your inquiry was received. An advisor will contact you within 24-48 hours.</p>
</div>
</form>
</div>
</div>
</div>
<!-- Reassurance Banner -->
<div class="mt-spacing-3xl bg-surface-container-low rounded-xl p-spacing-xl">
<div class="grid grid-cols-1 md:grid-cols-3 gap-spacing-xl items-center text-center md:text-left">
<div class="flex items-center justify-center md:justify-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-surface-container-lowest flex items-center justify-center flex-shrink-0 text-on-surface shadow-sm">
<span class="material-symbols-outlined text-[24px]">verified_user</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">30-Day Ritual Guarantee</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Not seeing revitalized hair? Effortless refund.</p>
</div>
</div>
<div class="flex items-center justify-center md:justify-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-surface-container-lowest flex items-center justify-center flex-shrink-0 text-on-surface shadow-sm">
<span class="material-symbols-outlined text-[24px]">local_shipping</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Shipping Assistance</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Real-time dispatch tracking on orders over $50.</p>
</div>
</div>
<div class="flex items-center justify-center md:justify-start gap-spacing-md">
<div class="w-12 h-12 rounded-full bg-surface-container-lowest flex items-center justify-center flex-shrink-0 text-on-surface shadow-sm">
<span class="material-symbols-outlined text-[24px]">biotech</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Dermatologist Formulated</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Backed by Australian laboratory research.</p>
</div>
</div>
</div>
</div>
