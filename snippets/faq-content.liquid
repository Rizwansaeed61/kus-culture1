<!-- Interactive & Search Filter Script -->
<script>
    function switchTab(category) {
      document.querySelectorAll('[data-faq-cat]').forEach(card => {
        if (category === 'all' || card.getAttribute('data-faq-cat') === category) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
      document.querySelectorAll('.tab-btn').forEach(btn => {
        if (btn.getAttribute('data-target') === category) {
          btn.classList.add('bg-primary', 'text-on-primary', 'shadow-md');
          btn.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
          btn.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
        }
      });
    }

    function toggleAccordion(btn) {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('.accordion-icon');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
      }
    }

    function filterFaqs() {
      const query = document.getElementById('faq-search-input').value.toLowerCase();
      document.querySelectorAll('[data-faq-cat]').forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(query)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function copyPromoCode(btn, code) {
      navigator.clipboard.writeText(code);
      const originalHtml = btn.innerHTML;
      btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">check</span> Copied!`;
      setTimeout(() => {
        btn.innerHTML = originalHtml;
      }, 2000);
    }
  </script>
