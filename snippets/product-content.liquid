  document.querySelectorAll('.size-card-fb').forEach(card => {
    card.classList.remove('ring-2', 'ring-primary', 'shadow-md');
    card.classList.add('shadow-sm');
  });
  const el = document.getElementById('tier-' + tier + '-fb');
  if (el) {
    el.classList.add('ring-2', 'ring-primary', 'shadow-md');
  }
  const dp = document.getElementById('display-price-fb');
  const cp = document.getElementById('cta-price-prefix-fb');
  if (dp) dp.textContent = price;
  if (cp) cp.textContent = price;
}

