<script>
function filterCategory(cat, button) {
  document.querySelectorAll('.collection-tab-btn').forEach(btn => {
    btn.classList.remove('bg-primary', 'text-on-primary');
    btn.classList.add('bg-surface-container-low', 'text-on-surface');
  });
  button.classList.remove('bg-surface-container-low', 'text-on-surface');
  button.classList.add('bg-primary', 'text-on-primary');

  document.querySelectorAll('.shop-product-card').forEach(card => {
    if (cat === 'all' || card.dataset.cat === cat || card.dataset.cat === 'all') {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}
</script>

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair Care Collection & Shop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Targeted follicular trichology, microbiome-safe scalp balms, and cold-pressed Australian native botanicals formulated to halt shedding and restore density."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Clinical Laboratory Series"
    },
    {
      "type": "text",
      "id": "origin_text",
      "label": "Origin location text",
      "default": "Melbourne, Australia"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "category_tab",
      "name": "Category Filter Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Label",
          "default": "New Category"
        },
        {
          "type": "text",
          "id": "filter_key",
          "label": "Filter Tag/Key",
          "default": "all"
        }
      ]
    },
    {
      "type": "promo_card",
      "name": "Promo Banner Card",
      "settings": [
        {
          "type": "text",
