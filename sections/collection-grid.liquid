<section class="w-full bg-surface py-12">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Hero Header -->
    <div class="space-y-4 pb-8 border-b border-surface-container">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-surface-container text-on-surface text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Clinical Laboratory Series
        </span>
        <span class="text-xs text-on-surface-variant">• Melbourne, Australia</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl text-on-surface font-semibold tracking-tight">
        {{ collection.title | default: 'Hair Care Collection & Shop' }}
      </h1>
      <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
        {{ collection.description | default: 'Targeted follicular trichology, microbiome-safe scalp balms, and cold-pressed Australian native botanicals formulated to halt shedding and restore density.' }}
      </p>

      <!-- Category Filter Tabs -->
      <div class="pt-4 flex flex-wrap items-center gap-2" id="collectionFilterTabs">
        <button type="button" onclick="filterCategory('all', this)" class="collection-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-primary text-on-primary shadow-sm">
          All Formulas
        </button>
        <button type="button" onclick="filterCategory('fall', this)" class="collection-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-surface-container-low hover:bg-surface-container text-on-surface shadow-sm">
          Anti Hair Fall Series
        </button>
        <button type="button" onclick="filterCategory('scalp', this)" class="collection-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-surface-container-low hover:bg-surface-container text-on-surface shadow-sm">
          Scalp Microbiome
        </button>
        <button type="button" onclick="filterCategory('hydrate', this)" class="collection-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-surface-container-low hover:bg-surface-container text-on-surface shadow-sm">
          Deep Hydration
        </button>
        <button type="button" onclick="filterCategory('bundle', this)" class="collection-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-surface-container-low hover:bg-surface-container text-on-surface shadow-sm">
          Clinical Regimen Bundles
        </button>
      </div>
    </div>

    <!-- Collection Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-10" id="collectionProductsGrid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <div class="shop-product-card bg-surface-container-lowest rounded-3xl p-6 shadow-sm hover:shadow-md transition-all border border-surface-container flex flex-col justify-between" data-cat="all">
            <div>
              <div class="relative w-full aspect-square bg-surface-container-low rounded-2xl flex items-center justify-center p-6 overflow-hidden mb-4 border border-surface-container">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="max-h-full max-w-full object-contain hover:scale-105 transition-transform duration-300"/>
                {% endif %}
                <span class="absolute top-3 left-3 bg-surface-container-lowest/90 px-2.5 py-0.5 rounded-full text-[10px] font-bold text-on-surface shadow-sm">
                  {{ product.type | default: 'Clinical Formula' }}
                </span>
              </div>

              <div class="flex items-center gap-1.5 text-tertiary-container mb-2">
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="text-xs font-bold text-on-surface ml-1">5.0</span>
              </div>

              <h3 class="font-serif text-lg font-semibold text-on-surface leading-snug">
                <a href="{{ product.url }}" class="hover:text-secondary transition-colors">{{ product.title }}</a>
              </h3>
              <p class="text-xs text-on-surface-variant line-clamp-2 mt-1">{{ product.description | strip_html | truncate: 90 }}</p>
            </div>

            <div class="pt-4 mt-4 border-t border-surface-container flex items-center justify-between">
              <span class="font-serif text-xl font-bold text-on-surface">{{ product.price | money }}</span>
              <button type="button" onclick="shopifyAddToCart('{{ product.selected_or_first_available_variant.id }}')" class="bg-primary text-on-primary font-bold text-xs uppercase px-5 py-2.5 rounded-full hover:bg-primary-container transition-colors shadow-sm">
                Add to Bag
