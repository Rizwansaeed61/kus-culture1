<section class="w-full bg-surface-container-low py-12 border-y border-surface-container">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
            {% when 'trust_item' %}
              <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm flex items-center gap-4 border border-surface-container" {{ block.shopify_attributes }}>
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
                  <span class="material-symbols-outlined text-[24px]">{{ block.settings.icon | default: 'verified_user' }}</span>
                </div>
                <div>
                  <h4 class="font-bold text-on-surface text-sm">{{ block.settings.title }}</h4>
                  <p class="text-xs text-on-surface-variant">{{ block.settings.subtitle }}</p>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      {% else %}
        <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm flex items-center gap-4 border border-surface-container">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
            <span class="material-symbols-outlined text-[24px]">local_shipping</span>
          </div>
          <div>
            <h4 class="font-bold text-on-surface text-sm">Free Shipping</h4>
            <p class="text-xs text-on-surface-variant">On orders over $50+</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm flex items-center gap-4 border border-surface-container">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
            <span class="material-symbols-outlined text-[24px]">verified_user</span>
          </div>
          <div>
            <h4 class="font-bold text-on-surface text-sm">Dermatologist</h4>
            <p class="text-xs text-on-surface-variant">Approved formula</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm flex items-center gap-4 border border-surface-container">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
            <span class="material-symbols-outlined text-[24px]">published_with_changes</span>
          </div>
          <div>
            <h4 class="font-bold text-on-surface text-sm">30-Day Returns</h4>
            <p class="text-xs text-on-surface-variant">Money back guarantee</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm flex items-center gap-4 border border-surface-container">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
            <span class="material-symbols-outlined text-[24px]">lock</span>
          </div>
          <div>
            <h4 class="font-bold text-on-surface text-sm">Secure Checkout</h4>
            <p class="text-xs text-on-surface-variant">256-bit SSL encryption</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust guarantee",
  "tag": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "trust_item",
      "name": "Trust Guarantee Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Material Icon Name", "default": "verified_user" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On orders over $50+" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "trust_item", "settings": { "icon": "local_shipping", "title": "Free Shipping", "subtitle": "On orders over $50+" } },
      { "type": "trust_item", "settings": { "icon": "verified_user", "title": "Dermatologist", "subtitle": "Approved formula" } },
      { "type": "trust_item", "settings": { "icon": "published_with_changes", "title": "30-Day Returns", "subtitle": "Money back guarantee" } },
      { "type": "trust_item", "settings": { "icon": "lock", "title": "Secure Checkout", "subtitle": "256-bit SSL encryption" } }
    ]
  },
  "presets": [
    {
      "name": "Trust guarantee",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "local_shipping", "title": "Free Shipping", "subtitle": "On orders over $50+" } },
        { "type": "trust_item", "settings": { "icon": "verified_user", "title": "Dermatologist", "subtitle": "Approved formula" } },
        { "type": "trust_item", "settings": { "icon": "published_with_changes", "title": "30-Day Returns", "subtitle": "Money back guarantee" } },
        { "type": "trust_item", "settings": { "icon": "lock", "title": "Secure Checkout", "subtitle": "256-bit SSL encryption" } }
      ]
    }
  ]
}
{% endschema %}
