<section class="w-full bg-surface py-16" id="bestseller-suite">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-10">
      <div>
        <span class="text-xs uppercase text-secondary font-bold tracking-wider">{{ section.settings.eyebrow | default: 'Clinical Efficacy Showcase' }}</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-semibold">{{ section.settings.heading | default: 'HairRevive™ Anti Hair Fall Shampoo' }}</h2>
        <p class="text-sm text-on-surface-variant mt-1">{{ section.settings.subheading | default: 'Strengthens cellular roots & activates sustained healthy hair cycles.' }}</p>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex items-center text-tertiary-container">
          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
        </div>
        <span class="text-sm text-on-surface font-bold">4.9 / 5.0</span>
        <span class="text-xs text-on-surface-variant">(2,341 Clinical Reviews)</span>
      </div>
    </div>

    {% assign current_product = section.settings.product | default: all_products['hairrevive-shampoo'] %}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Media Gallery -->
      <div class="lg:col-span-6 space-y-4">
        <div class="relative bg-surface-container-low rounded-3xl p-8 flex flex-col items-center justify-center min-h-[460px] shadow-sm border border-surface-container">
          <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
            <span class="inline-flex items-center gap-1 bg-primary text-on-primary px-3 py-1 rounded-full text-xs uppercase font-bold shadow-md">
              <span class="material-symbols-outlined text-[14px]">local_fire_department</span>
              BESTSELLER
            </span>
            <span class="inline-flex items-center bg-surface-container-lowest text-on-surface px-3 py-1 rounded-full text-xs font-semibold shadow-sm">
              Safe for Colored Hair
            </span>
          </div>
          <div class="absolute top-4 right-4 flex flex-col gap-2 z-10 items-end">
            <span class="bg-tertiary-fixed text-on-tertiary-fixed px-3 py-1 rounded-full text-xs font-bold shadow-sm">
              Sulfate Free
            </span>
            <span class="bg-surface-container-lowest text-on-surface px-3 py-1 rounded-full text-xs font-semibold shadow-sm">
              Dermatologist Tested
            </span>
          </div>

          <div class="relative w-full max-w-[320px] h-[360px] flex items-center justify-center py-4">
            {% if current_product.featured_image %}
              <img id="mainProductImage" class="max-h-full w-auto object-contain drop-shadow-xl" src="{{ current_product.featured_image | image_url: width: 600 }}" alt="{{ current_product.title }}"/>
            {% else %}
              <img id="mainProductImage" class="max-h-full w-auto object-contain drop-shadow-xl" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFCR5RYUEWtEvP01b_APRd4TmRQCmm8fj7LR5TxKDIlAprC8TLOJyYpDD6xW_tulRoQF95ZTZ1e6Q877YaiYcjBaPWej6RAzcP592WD7MOJcFMxzM6_l1U-8GzXNzUcHybWbYWCSmLAFSV16Zv5ZCtJswcIrt2uaOObILBILYed2uXtBbmev8dfKQY4ClNfwVb00DexL7sdyJ6HASj-qxWwTaYp7xevk3DXjpPGYL_rbxietzICsZA" alt="KUS Culture Shampoo"/>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Right Buy Box with Dynamic Blocks -->
      <div class="lg:col-span-6 space-y-6 bg-surface-container-lowest p-6 sm:p-8 rounded-3xl shadow-sm border border-surface-container">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
              {% when '@theme' %}
                <div {{ block.shopify_attributes }}>{% content_for 'block', type: block.type, id: block.id %}</div>

              {% when 'badge' %}
                <div class="inline-flex items-center gap-2 bg-secondary-container text-on-surface px-3 py-1 rounded-full text-xs font-bold" {{ block.shopify_attributes }}>
                  <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                  {{ block.settings.badge | default: 'For Hair Fall & Weak Hair' }}
                </div>

              {% when 'title' %}
                <h3 class="font-serif text-2xl sm:text-3xl text-on-surface font-semibold pt-1" {{ block.shopify_attributes }}>
                  {{ current_product.title | default: 'HairRevive™ Anti Hair Fall Shampoo' }}
                </h3>

              {% when 'price' %}
                <div class="flex items-baseline gap-3 pt-1" {{ block.shopify_attributes }}>
                  <span class="font-serif text-3xl sm:text-4xl text-on-surface font-bold" id="shopify-active-price">
                    {{ current_product.price | default: 2499 | money }}
                  </span>
                </div>

              {% when 'size_selector' %}
                <div class="space-y-3" {{ block.shopify_attributes }}>
                  <span class="font-bold text-on-surface text-sm uppercase tracking-wider block">Select Size</span>
                  <div class="grid grid-cols-3 gap-3">
                    <div id="showcase-tier-trial" onclick="selectShowcaseTier('trial', '$24.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-high ring-2 ring-primary transition-all flex flex-col justify-between shadow-md relative">
                      <span class="text-[10px] text-on-surface-variant uppercase font-bold">TRIAL</span>
                      <p class="font-bold text-on-surface text-sm mt-2">500ml</p>
                      <p class="text-sm font-semibold text-on-surface">$24.99</p>
                    </div>
                    <div id="showcase-tier-popular" onclick="selectShowcaseTier('popular', '$49.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-low hover:bg-surface-container transition-all flex flex-col justify-between shadow-sm relative">
                      <span class="text-[10px] text-on-surface-variant uppercase font-bold">POPULAR</span>
                      <p class="font-bold text-on-surface text-sm mt-2">1 Liter</p>
                      <p class="text-sm font-semibold text-on-surface">$49.99</p>
                    </div>
                    <div id="showcase-tier-best" onclick="selectShowcaseTier('best', '$84.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-low hover:bg-surface-container transition-all flex flex-col justify-between shadow-sm relative">
                      <span class="text-[10px] text-on-surface-variant uppercase font-bold">BEST VALUE</span>
                      <p class="font-bold text-on-surface text-sm mt-2">1.5 Liter</p>
                      <p class="text-sm font-semibold text-on-surface">$84.99</p>
                    </div>
                  </div>
                </div>

              {% when 'coupon_banner' %}
                <div onclick="copyCoupon('HAIR15', document.getElementById('showcase-copy-btn'))" class="bg-tertiary-fixed/40 border border-tertiary-fixed rounded-2xl p-4 flex items-center justify-between gap-3 shadow-sm cursor-pointer hover:bg-tertiary-fixed/60 transition-colors" {{ block.shopify_attributes }}>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed flex-shrink-0 shadow-sm">
                      <span class="material-symbols-outlined text-[20px]">percent</span>
                    </div>
                    <div>
                      <p class="text-sm font-bold text-on-surface">Buy 3 & Get 15% OFF</p>
                      <p class="text-xs text-on-surface-variant">Code: <span class="font-bold text-on-surface tracking-wider">HAIR15</span></p>
                    </div>
                  </div>
                  <button id="showcase-copy-btn" type="button" onclick="copyCoupon('HAIR15', this); event.stopPropagation();" class="inline-flex items-center gap-1.5 bg-surface text-on-surface px-4 py-2 rounded-full text-xs font-bold shadow-sm hover:bg-surface-container transition-all active:scale-95">
                    <span class="material-symbols-outlined text-[15px]">content_copy</span>
                    <span>Copy</span>
                  </button>
                </div>

              {% when 'buy_buttons' %}
                <div {{ block.shopify_attributes }}>
                  <button type="button" onclick="shopifyAddToCart('{{ current_product.selected_or_first_available_variant.id }}')"
                          class="w-full bg-primary text-on-primary font-bold text-sm sm:text-base uppercase tracking-wider py-4 px-8 rounded-full shadow-lg hover:bg-primary-container transition-all flex items-center justify-center gap-3 active:scale-[0.99]">
                    <span>ADD TO CART</span>
                    <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                  </button>
                </div>

              {% when 'custom_liquid' %}
                <div {{ block.shopify_attributes }}>
                  {{ block.settings.custom_liquid }}
                </div>
            {% endcase %}
          {% endfor %}
        {% else %}
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 bg-secondary-container text-on-surface px-3 py-1 rounded-full text-xs font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              For Hair Fall & Weak Hair
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl text-on-surface font-semibold pt-1">
              {{ current_product.title | default: 'HairRevive™ Anti Hair Fall Shampoo' }}
            </h3>
            <div class="flex items-baseline gap-3 pt-1">
              <span class="font-serif text-3xl sm:text-4xl text-on-surface font-bold" id="shopify-active-price">
                {{ current_product.price | default: 2499 | money }}
              </span>
            </div>
          </div>

          <!-- 3 Size Tier Options -->
          <div class="space-y-3">
            <span class="font-bold text-on-surface text-sm uppercase tracking-wider block">Select Size</span>
            <div class="grid grid-cols-3 gap-3">
              <div id="showcase-tier-trial" onclick="selectShowcaseTier('trial', '$24.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-high ring-2 ring-primary transition-all flex flex-col justify-between shadow-md relative">
                <span class="text-[10px] text-on-surface-variant uppercase font-bold">TRIAL</span>
                <p class="font-bold text-on-surface text-sm mt-2">500ml</p>
                <p class="text-sm font-semibold text-on-surface">$24.99</p>
              </div>
              <div id="showcase-tier-popular" onclick="selectShowcaseTier('popular', '$49.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-low hover:bg-surface-container transition-all flex flex-col justify-between shadow-sm relative">
                <span class="text-[10px] text-on-surface-variant uppercase font-bold">POPULAR</span>
                <p class="font-bold text-on-surface text-sm mt-2">1 Liter</p>
                <p class="text-sm font-semibold text-on-surface">$49.99</p>
              </div>
              <div id="showcase-tier-best" onclick="selectShowcaseTier('best', '$84.99')" class="showcase-size-card cursor-pointer rounded-2xl p-3 bg-surface-container-low hover:bg-surface-container transition-all flex flex-col justify-between shadow-sm relative">
                <span class="text-[10px] text-on-surface-variant uppercase font-bold">BEST VALUE</span>
                <p class="font-bold text-on-surface text-sm mt-2">1.5 Liter</p>
                <p class="text-sm font-semibold text-on-surface">$84.99</p>
              </div>
            </div>
          </div>

          <!-- Promo Discount Banner -->
          <div onclick="copyCoupon('HAIR15', document.getElementById('showcase-copy-btn'))" class="bg-tertiary-fixed/40 border border-tertiary-fixed rounded-2xl p-4 flex items-center justify-between gap-3 shadow-sm cursor-pointer hover:bg-tertiary-fixed/60 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed flex-shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">percent</span>
              </div>
              <div>
                <p class="text-sm font-bold text-on-surface">Buy 3 & Get 15% OFF</p>
                <p class="text-xs text-on-surface-variant">Code: <span class="font-bold text-on-surface tracking-wider">HAIR15</span></p>
              </div>
            </div>
            <button id="showcase-copy-btn" type="button" onclick="copyCoupon('HAIR15', this); event.stopPropagation();" class="inline-flex items-center gap-1.5 bg-surface text-on-surface px-4 py-2 rounded-full text-xs font-bold shadow-sm hover:bg-surface-container transition-all active:scale-95">
              <span class="material-symbols-outlined text-[15px]">content_copy</span>
              <span>Copy</span>
            </button>
          </div>

          <!-- Add to cart CTA -->
          <button type="button" onclick="shopifyAddToCart('{{ current_product.selected_or_first_available_variant.id }}')"
                  class="w-full bg-primary text-on-primary font-bold text-sm sm:text-base uppercase tracking-wider py-4 px-8 rounded-full shadow-lg hover:bg-primary-container transition-all flex items-center justify-center gap-3 active:scale-[0.99]">
            <span>ADD TO CART</span>
            <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Clinical Efficacy Showcase"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HairRevive™ Anti Hair Fall Shampoo"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Strengthens cellular roots & activates sustained healthy hair cycles."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Featured Product"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "badge",
      "name": "Benefit Badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "For Hair Fall & Weak Hair"
        }
      ]
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Product Price",
      "limit": 1
    },
    {
      "type": "size_selector",
      "name": "Size Selector",
      "limit": 1
    },
    {
      "type": "coupon_banner",
      "name": "Promo Coupon Banner",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "badge" },
      { "type": "title" },
      { "type": "price" },
      { "type": "size_selector" },
      { "type": "coupon_banner" },
      { "type": "buy_buttons" }
    ]
  },
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        { "type": "badge" },
        { "type": "title" },
        { "type": "price" },
        { "type": "size_selector" },
        { "type": "coupon_banner" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
