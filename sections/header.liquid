<header class="fixed top-0 w-full z-50">
  <div class="w-full bg-surface/90 backdrop-blur-xl border-b border-surface-container shadow-sm">
    <div class="h-20 max-w-7xl mx-auto px-6 flex items-center justify-between gap-6">
      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="flex items-center gap-3 flex-shrink-0 group">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" class="h-8 w-auto object-contain group-hover:opacity-80 transition-opacity"/>
        {% else %}
          <span class="font-serif text-2xl font-bold tracking-widest text-on-surface group-hover:opacity-80 transition-opacity">KUS•CULTURE</span>
        {% endif %}
      </a>

      {% assign about_url = '/pages/about' %}
      {% if pages['about-us'].url != blank %}
        {% assign about_url = pages['about-us'].url %}
      {% elsif pages['about'].url != blank %}
        {% assign about_url = pages['about'].url %}
      {% endif %}

      {% assign faq_url = '/pages/faq' %}
      {% if pages['faqs'].url != blank %}
        {% assign faq_url = pages['faqs'].url %}
      {% elsif pages['faq'].url != blank %}
        {% assign faq_url = pages['faq'].url %}
      {% endif %}

      {% assign contact_url = '/pages/contact' %}
      {% if pages['contact-us'].url != blank %}
        {% assign contact_url = pages['contact-us'].url %}
      {% elsif pages['contact'].url != blank %}
        {% assign contact_url = pages['contact'].url %}
      {% endif %}

      {% assign blog_url = '/blogs/hair-journal' %}
      {% if blogs['hair-journal'].url != blank %}
        {% assign blog_url = blogs['hair-journal'].url %}
      {% elsif blogs['news'].url != blank %}
        {% assign blog_url = blogs['news'].url %}
      {% endif %}

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-6">
        {% if section.settings.use_kus_navigation %}
          <a href="{{ routes.root_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.page_type == 'index' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            Home
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.page_type == 'collection' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            Hair Care / Shop
          </a>
          <a href="{{ about_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.path contains 'about' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            About Us
          </a>
          <a href="{{ blog_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.page_type == 'blog' or request.page_type == 'article' or request.path contains 'blog' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            Blog
          </a>
          <a href="{{ faq_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.path contains 'faq' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            FAQs
          </a>
          <a href="{{ contact_url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if request.path contains 'contact' %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
            Contact Us
          </a>
        {% else %}
          {% for link in linklists[section.settings.menu].links %}
            <a href="{{ link.url }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors {% if link.active %}bg-secondary-container text-on-surface font-bold rounded-full px-4 py-1.5 shadow-sm{% endif %}">
              {{ link.title }}
            </a>
          {% endfor %}
        {% endif %}
      </nav>

      <!-- Right Utility Actions -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <button type="button" onclick="HairQuiz.openQuiz()" class="hidden sm:inline-flex items-center gap-1.5 bg-surface-container hover:bg-surface-container-high px-3.5 py-1.5 rounded-full text-xs font-semibold text-on-surface transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[16px]">science</span>
          <span>Hair Diagnostic</span>
        </button>

        <button type="button" onclick="openCartDrawer()" aria-label="View shopping bag" class="relative w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors">
          <span class="material-symbols-outlined text-[22px]">shopping_bag</span>
          <span class="cart-badge-count absolute top-1.5 right-1.5 w-4 h-4 rounded-full bg-primary text-on-primary text-[10px] font-bold flex items-center justify-center">{{ cart.item_count }}</span>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" onclick="toggleMobileMenu()" class="lg:hidden w-10 h-10 rounded-full flex items-center justify-center hover:bg-surface-container text-on-surface transition-colors" aria-label="Toggle navigation menu">
          <span class="material-symbols-outlined text-[22px]">menu</span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav-drawer" class="hidden lg:hidden bg-surface-container-lowest border-b border-surface-container px-6 py-4 space-y-3">
      <a href="{{ routes.root_url }}" class="block text-sm font-semibold text-on-surface py-1">Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="block text-sm font-semibold text-on-surface py-1">Hair Care / Shop</a>
      <a href="{{ about_url }}" class="block text-sm font-semibold text-on-surface py-1">About Us</a>
      <a href="{{ blog_url }}" class="block text-sm font-semibold text-on-surface py-1">Blog</a>
      <a href="{{ faq_url }}" class="block text-sm font-semibold text-on-surface py-1">FAQs</a>
      <a href="{{ contact_url }}" class="block text-sm font-semibold text-on-surface py-1">Contact Us</a>
      <button type="button" onclick="toggleMobileMenu(); HairQuiz.openQuiz();" class="w-full mt-2 bg-surface-container text-on-surface font-bold text-xs py-2.5 rounded-full flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[16px]">science</span>
        <span>Take Hair Diagnostic</span>
      </button>
    </div>
  </div>
</header>

<script>
function toggleMobileMenu() {
  const drawer = document.getElementById('mobile-nav-drawer');
  if (drawer) {
    drawer.classList.toggle('hidden');
  }
}
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "checkbox",
      "id": "use_kus_navigation",
      "label": "Use Full KUS CULTURE Navigation Menu",
      "default": true,
      "info": "Displays Home, Hair Care / Shop, Bestseller Shampoo, About Us, FAQs, and Contact Us automatically."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (Fallback if option above is unchecked)",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
