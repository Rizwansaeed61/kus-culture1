<section class="w-full bg-surface py-16" id="reviews">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between pb-8">
      <div>
        <span class="text-xs uppercase text-secondary font-bold tracking-wider">{{ section.settings.eyebrow | default: 'Social Proof' }}</span>
        <h2 class="font-serif text-3xl text-on-surface font-semibold">{{ section.settings.heading | default: 'What Customers Say' }}</h2>
      </div>
      <a class="text-sm font-bold text-on-surface-variant hover:text-on-surface underline" href="#reviews">See all 2,341 reviews</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Rating Summary Card -->
      <div class="lg:col-span-4 bg-surface-container-lowest p-8 rounded-3xl shadow-sm border border-surface-container space-y-4">
        <div class="flex items-baseline gap-2">
          <span class="font-serif text-5xl font-bold text-on-surface">4.9</span>
          <span class="text-lg text-on-surface-variant">/ 5.0</span>
        </div>
        <div class="flex items-center text-tertiary-container">
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
        </div>
        <p class="text-xs text-on-surface-variant">Based on 2,341 verified independent purchaser reviews.</p>

        <div class="pt-2 space-y-2 border-t border-surface-container">
          <div class="flex items-center justify-between text-xs text-on-surface-variant">
            <span>Hair Density Revival</span>
            <span class="font-bold text-on-surface">96%</span>
          </div>
          <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
            <div class="bg-primary h-full rounded-full" style="width: 96%;"></div>
          </div>

          <div class="flex items-center justify-between text-xs text-on-surface-variant pt-1">
            <span>Fall Reduction in 21 Days</span>
            <span class="font-bold text-on-surface">92%</span>
          </div>
          <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
            <div class="bg-primary h-full rounded-full" style="width: 92%;"></div>
          </div>
        </div>
      </div>

      <!-- Testimonials / UGC Dynamic Blocks Column -->
      <div class="lg:col-span-8 bg-surface-container-lowest p-8 rounded-3xl shadow-sm border border-surface-container space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="relative rounded-2xl overflow-hidden h-60 bg-surface-container">
            <img class="w-full h-full object-cover" alt="Foam texture" src="https://lh3.googleusercontent.com/aida-public/AB6AXuADyH6d7Qx7z8Z4DeV7XN1kNfRmJV118RP2xWzfj2d8ED3SyXGt-qNcv-NHsIw6CMqU0u2hueW2NORD_57CzRrV6ipqy9kJffFDreXhsamefoZXMwTduxZfmfvURHnqFwSCgsGnhXCzZ6P1_6dv8wp03ibrzeDj2QASnYS2PIrcyLGcE5_I7Ns4FVSCQLWw1KWrR1SjoEopSSvmD27AWTgHqnRaq3C5nETeujEYipK8moVlREpqjvTn"/>
            <div class="absolute bottom-2 left-2 bg-surface/90 backdrop-blur-sm px-3 py-0.5 rounded-full text-xs text-on-surface font-semibold shadow-sm">
              Foam Lather Texture
            </div>
          </div>
          <div class="relative rounded-2xl overflow-hidden h-60 bg-surface-container">
            <img class="w-full h-full object-cover" alt="Customer unboxing" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBdUszxYaaAFbWynqG-OMdrQk49jMnpcuTxvNrcPuNfrkUg5j8-LaJvlWyEswAEJ26KCL6gEK7QiECUNdWRBuslClLdDa3AE9ep1REhZ0oUtHq2POvL7v6T6ZKqKusYKdB370JyhBHoxWFatQhE-m1-2wNZnZBqC7MZslqxh2opOAGb3A8KpyBiRUFrbcWoj1LwHqFaWJv4vwh5R9ggfIul1HPiAqpRFyvoZm8vl6YL1oh-hkoEGhfC"/>
            <div class="absolute bottom-2 left-2 bg-surface/90 backdrop-blur-sm px-3 py-0.5 rounded-full text-xs text-on-surface font-semibold shadow-sm">
              Unboxing Day 1
            </div>
          </div>
        </div>

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
              {% when 'testimonial' %}
                <div class="pt-2 space-y-2 border-t border-surface-container first:border-t-0" {{ block.shopify_attributes }}>
                  <blockquote class="font-serif text-lg text-on-surface font-semibold italic">
                    "{{ block.settings.quote }}"
                  </blockquote>
                  <div class="flex items-center gap-2 pt-1">
                    <span class="material-symbols-outlined text-[18px] text-emerald-600 font-bold">check_circle</span>
                    <span class="text-xs font-bold text-on-surface">{{ block.settings.author }}</span>
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        {% else %}
          <div class="pt-2 space-y-2">
            <blockquote class="font-serif text-lg text-on-surface font-semibold italic">
              "{{ section.settings.quote | default: 'My hair fall reduced visibly in 3 weeks. It smells fresh, clean and does not dry my scalp.' }}"
            </blockquote>
            <div class="flex items-center gap-2 pt-1">
              <span class="material-symbols-outlined text-[18px] text-emerald-600 font-bold">check_circle</span>
              <span class="text-xs font-bold text-on-surface">{{ section.settings.author | default: 'Verified Purchaser • Priya M.' }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Social Proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Customers Say" },
    { "type": "text", "id": "quote", "label": "Default Review Quote", "default": "My hair fall reduced visibly in 3 weeks. It smells fresh, clean and does not dry my scalp." },
    { "type": "text", "id": "author", "label": "Default Review Author", "default": "Verified Purchaser • Priya M." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "testimonial",
      "name": "Customer Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Customer Review Quote", "default": "My hair fall reduced visibly in 3 weeks. It smells fresh, clean and does not dry my scalp." },
        { "type": "text", "id": "author", "label": "Author & Location", "default": "Verified Purchaser • Priya M." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "My hair fall reduced visibly in 3 weeks. It smells fresh, clean and does not dry my scalp.", "author": "Verified Purchaser • Priya M. (Melbourne)" } },
      { "type": "testimonial", "settings": { "quote": "Noticeable new baby hair around my hairline after 6 weeks of using the shampoo and serum duo.", "author": "Verified Purchaser • Chloe S. (Sydney)" } }
    ]
  },
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "My hair fall reduced visibly in 3 weeks. It smells fresh, clean and does not dry my scalp.", "author": "Verified Purchaser • Priya M. (Melbourne)" } }
      ]
    }
  ]
}
{% endschema %}
