<section class="w-full bg-surface-container-low py-16 border-y border-surface-container" id="hair-quiz">
  <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
          {% when 'heading' %}
            <div class="space-y-2" {{ block.shopify_attributes }}>
              {% if block.settings.eyebrow != blank %}
                <span class="text-xs uppercase tracking-widest text-secondary font-bold">{{ block.settings.eyebrow }}</span>
              {% endif %}
              <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-semibold">{{ block.settings.heading | default: 'Find Your Custom Hair Care Regimen' }}</h2>
            </div>
          {% when 'text' %}
            <p class="text-sm sm:text-base text-on-surface-variant max-w-xl mx-auto leading-relaxed" {{ block.shopify_attributes }}>
              {{ block.settings.text | default: 'Take our 60-second diagnostic formulated by Australian dermatologists to pinpoint your scalp type, shed factors, and targeted active botanical balance.' }}
            </p>
          {% when 'button' %}
            <div class="pt-2" {{ block.shopify_attributes }}>
              <button type="button" onclick="HairQuiz.openQuiz()" class="bg-primary text-on-primary font-bold text-xs sm:text-sm uppercase tracking-wider px-8 py-4 rounded-full shadow-lg hover:bg-primary-container transition-all inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">quiz</span>
                <span>{{ block.settings.button_label | default: 'Start 60-Second Diagnostic' }}</span>
              </button>
            </div>
        {% endcase %}
      {% endfor %}
    {% else %}
      <span class="text-xs uppercase tracking-widest text-secondary font-bold">Personalized Trichology</span>
      <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-semibold">{{ section.settings.heading | default: 'Find Your Custom Hair Care Regimen' }}</h2>
      <p class="text-sm sm:text-base text-on-surface-variant max-w-xl mx-auto leading-relaxed">
        {{ section.settings.subheading | default: 'Take our 60-second diagnostic formulated by Australian dermatologists to pinpoint your scalp type, shed factors, and targeted active botanical balance.' }}
      </p>
      <div class="pt-2">
        <button type="button" onclick="HairQuiz.openQuiz()" class="bg-primary text-on-primary font-bold text-xs sm:text-sm uppercase tracking-wider px-8 py-4 rounded-full shadow-lg hover:bg-primary-container transition-all inline-flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">quiz</span>
          <span>Start 60-Second Diagnostic</span>
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hair quiz banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Fallback Heading", "default": "Find Your Custom Hair Care Regimen" },
    { "type": "textarea", "id": "subheading", "label": "Fallback Subheading", "default": "Take our 60-second diagnostic formulated by Australian dermatologists to pinpoint your scalp type, shed factors, and targeted active botanical balance." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personalized Trichology" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your Custom Hair Care Regimen" }
      ]
    },
    {
      "type": "text",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Description", "default": "Take our 60-second diagnostic formulated by Australian dermatologists to pinpoint your scalp type, shed factors, and targeted active botanical balance." }
      ]
    },
    {
      "type": "button",
      "name": "Quiz Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Start 60-Second Diagnostic" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "heading" },
      { "type": "text" },
      { "type": "button" }
    ]
  },
  "presets": [
    {
      "name": "Hair quiz banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
