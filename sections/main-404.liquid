<div class="w-full">
  <!-- Dynamic Fallback Section: About Us -->
  <div id="kus-fallback-about" style="display: none;">
    {% render 'about-content' %}
  </div>

  <!-- Dynamic Fallback Section: FAQs -->
  <div id="kus-fallback-faq" style="display: none;">
    {% render 'faq-content' %}
  </div>

  <!-- Dynamic Fallback Section: Contact Us -->
  <div id="kus-fallback-contact" style="display: none;">
    {% render 'contact-content' %}
  </div>

  <!-- Dynamic Fallback Section: Bestseller Product -->
  <div id="kus-fallback-product" style="display: none;">
    {% render 'product-content' %}
  </div>

  <!-- Standard Branded 404 Screen -->
  <div id="kus-fallback-404" class="w-full bg-surface py-20 lg:py-28" style="display: none;">
    <div class="max-w-3xl mx-auto px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-container text-on-surface text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
        Status 404 • Page Relocated
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-on-surface font-semibold tracking-tight">
        Formula Not Found
      </h1>
      <p class="text-sm sm:text-base text-on-surface-variant max-w-lg mx-auto leading-relaxed">
        The clean botanical formula or ritual page you are searching for might have been updated, renamed, or relocated.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a href="{{ routes.root_url }}" class="bg-primary text-on-primary font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-full hover:bg-primary-container transition-all shadow-md">
          Return to Home Ritual
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="bg-surface-container-high text-on-surface font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-full hover:bg-surface-container transition-all shadow-sm">
          Explore Hair Care
        </a>
        <button type="button" onclick="HairQuiz.openQuiz()" class="bg-secondary-container text-on-surface font-bold text-xs px-6 py-3.5 rounded-full hover:opacity-90 transition-all shadow-sm">
          Take Hair Diagnostic
        </button>
      </div>

      <!-- Quick Navigation Directory -->
      <div class="pt-12 border-t border-surface-container mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
        <a href="{{ routes.root_url }}" class="p-4 rounded-2xl bg-surface-container-low hover:bg-surface-container transition-colors border border-surface-container">
          <span class="text-[10px] text-on-surface-variant uppercase font-bold">Start</span>
          <p class="font-bold text-sm text-on-surface mt-1">Home Page</p>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="p-4 rounded-2xl bg-surface-container-low hover:bg-surface-container transition-colors border border-surface-container">
          <span class="text-[10px] text-on-surface-variant uppercase font-bold">Catalog</span>
          <p class="font-bold text-sm text-on-surface mt-1">Hair Care / Shop</p>
        </a>
        <a href="/products/hairrevive-anti-hair-fall-shampoo" class="p-4 rounded-2xl bg-surface-container-low hover:bg-surface-container transition-colors border border-surface-container">
          <span class="text-[10px] text-on-surface-variant uppercase font-bold">Bestseller</span>
          <p class="font-bold text-sm text-on-surface mt-1">HairRevive™</p>
        </a>
        <a href="/pages/faq" class="p-4 rounded-2xl bg-surface-container-low hover:bg-surface-container transition-colors border border-surface-container">
          <span class="text-[10px] text-on-surface-variant uppercase font-bold">Support</span>
          <p class="font-bold text-sm text-on-surface mt-1">FAQs Help Desk</p>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var path = (window.location.pathname || '').toLowerCase();
  var search = (window.location.search || '').toLowerCase();
  var aboutEl = document.getElementById('kus-fallback-about');
  var faqEl = document.getElementById('kus-fallback-faq');
  var contactEl = document.getElementById('kus-fallback-contact');
  var productEl = document.getElementById('kus-fallback-product');
  var general404 = document.getElementById('kus-fallback-404');

  if (aboutEl) aboutEl.style.display = 'none';
  if (faqEl) faqEl.style.display = 'none';
  if (contactEl) contactEl.style.display = 'none';
  if (productEl) productEl.style.display = 'none';
  if (general404) general404.style.display = 'none';

  if (path.indexOf('about') !== -1 || search.indexOf('about') !== -1) {
    if (aboutEl) {
      aboutEl.style.display = 'block';
      document.title = 'About Us | KUS CULTURE';
    }
  } else if (path.indexOf('faq') !== -1 || search.indexOf('faq') !== -1) {
    if (faqEl) {
      faqEl.style.display = 'block';
      document.title = 'Frequently Asked Questions | KUS CULTURE';
    }
  } else if (path.indexOf('contact') !== -1 || search.indexOf('contact') !== -1) {
    if (contactEl) {
      contactEl.style.display = 'block';
      document.title = 'Contact Us | KUS CULTURE';
    }
  } else if (path.indexOf('shampoo') !== -1 || path.indexOf('hairrevive') !== -1 || path.indexOf('product') !== -1) {
    if (productEl) {
      productEl.style.display = 'block';
      document.title = 'HairRevive™ Anti Hair Fall Shampoo | KUS CULTURE';
    }
  } else {
    if (general404) {
      general404.style.display = 'block';
    }
  }
})();
</script>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
