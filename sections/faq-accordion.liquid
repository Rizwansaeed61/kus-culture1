          "settings": {
            "question": "When will I see results?",
            "answer": "Most users notice reduced shedding and hair trapped in brushes within 14 to 21 days. Noticeable new baby hair growth and thickening typically appear after 6 to 8 weeks."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for sensitive scalps?",
            "answer": "Formulated specifically for reactive scalps with aloe hydrosol and anti-inflammatory Australian botanical extracts. Dermatologist-tested, hypoallergenic, and non-comedogenic."
          }
        }
