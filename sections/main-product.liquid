</section>

<script>
function selectSize(tier, price, origPrice, savings) {
  document.querySelectorAll('.size-card').forEach(card => {
    card.classList.remove('ring-2', 'ring-primary', 'shadow-md');
    card.classList.add('shadow-sm');
  });
  const el = document.getElementById('tier-' + tier);
  if (el) {
    el.classList.add('ring-2', 'ring-primary', 'shadow-md');
  }
  const dp = document.getElementById('display-price');
  const cp = document.getElementById('cta-price-prefix');
  if (dp) dp.textContent = price;
  if (cp) cp.textContent = price;
  const op = document.getElementById('display-original-price');
  const st = document.getElementById('display-savings-tag');
  if (origPrice && op && st) {
    op.textContent = origPrice;
    op.classList.remove('hidden');
    st.textContent = savings;
    st.classList.remove('hidden');
  } else if (op && st) {
    op.classList.add('hidden');
    st.classList.add('hidden');
  }
}

function selectGalleryThumb(index) {
  const images = [
    "https://lh3.googleusercontent.com/aida-public/AB6AXuBFCR5RYUEWtEvP01b_APRd4TmRQCmm8fj7LR5TxKDIlAprC8TLOJyYpDD6xW_tulRoQF95ZTZ1e6Q877YaiYcjBaPWej6RAzcP592WD7MOJcFMxzM6_l1U-8GzXNzUcHybWbYWCSmLAFSV16Zv5ZCtJswcIrt2uaOObILBILYed2uXtBbmev8dfKQY4ClNfwVb00DexL7sdyJ6HASj-qxWwTaYp7xevk3DXjpPGYL_rbxietzICsZA",
