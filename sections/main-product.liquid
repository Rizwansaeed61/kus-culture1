          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container">
            <div class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
              <span class="material-symbols-outlined text-[18px]">health_and_safety</span>
            </div>
            <div>
              <p class="text-xs font-bold text-on-surface">Dermatologist</p>
              <p class="text-[10px] text-on-surface-variant">Approved formula</p>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container">
            <div class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0">
